{
  "agent": "family-lead-lag-spillover",
  "family": "cross-market spillover / lead-lag",
  "window": {
    "dev": [
      "2016-01-04",
      "2023-12-29"
    ],
    "holdout": "not loaded"
  },
  "idea": "SPY's cash-session move is a cleaner read on the common market factor than QQQ's own move.  A half-sigma SPY intraday decline is followed by a next-session QQQ/TQQQ bounce; hold one session, BIL otherwise.",
  "hypothesis": "SPY's prior-session return contains information about QQQ's next-session return beyond QQQ's own past return.  The orthogonalised residual should carry the edge if the effect is a genuine cross-market spillover rather than common-factor reversal.",
  "rules": {
    "signal": "SPY intraday total return, open-to-close, standardised by its trailing 20-session stdev through d-1",
    "event": "z <= -0.50",
    "entry": "TQQQ at the open of session d+1",
    "exit": "TQQQ at the 15:59 open of session d+1",
    "idle": "BIL",
    "decision_clock": "16:00 ET close of session d.  SPY and QQQ close at the same time; fills are next session's 09:30 open. No same-day information is used after 16:00.",
    "alignment": "SPY daily dates are inner-joined to the QQQ 1-minute session calendar; all 2,012 dev sessions have a SPY row. Daily SPY open is multiplied by adjclose/close so the overnight/intraday split is dividend-consistent."
  },
